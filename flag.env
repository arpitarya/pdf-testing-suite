# Feature flags for the PDF Comparison Suite.
#
# Plain KEY=value. Values are read at dev-server start and at build time; while
# `npm run dev` is running, saving this file reloads the browser with the new
# values, so no restart is needed.
#
# Truthy:  true, 1, on, yes, enabled   (case-insensitive)
# Falsy:   anything else, including a missing key.
#
# A flag that is not listed here falls back to the default in src/flags.ts.

# Click a page in Content / Layout side-by-side to pin a comment.
FEATURE_ANNOTATIONS=true

# "ZIP bundle" entry in the Export menu: every report plus annotated PDFs.
FEATURE_EXPORT_ZIP=true
